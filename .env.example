# ============================================
# TenderTrack — Пример конфигурации
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# ============================================
# Порты
# ============================================
# Порт фронтенда (веб-интерфейс)
FRONTEND_PORT=8080

# Порт бэкенда (API)
BACKEND_PORT=3001

# ============================================
# API ключи для источников тендеров
# ============================================
# ЕИС Закупки (zakupki.gov.ru)
# Требуется получить на сайте после регистрации
# ZAKUPKI_API_KEY=

# Росэлторг (roseltorg.ru)
# Токен доступа после авторизации
# ROSELTORG_TOKEN=

# Сбербанк-АСТ (sberbank-ast.ru)
# Путь к сертификату для SOAP API
# SBERBANK_AST_CERT=/path/to/cert.pem

# ============================================
# Интервалы синхронизации (в секундах)
# ============================================
# ЕИС — каждые 30 минут
SYNC_INTERVAL_EIS=1800

# Другие источники — каждый час
SYNC_INTERVAL_OTHER=3600

# ============================================
# База данных
# ============================================
# Путь к файлу БД (внутри контейнера)
# DB_PATH=/data/tendertrack.db

# ============================================
# Логирование
# ============================================
# Уровень логирования: debug, info, warn, error
# LOG_LEVEL=info
