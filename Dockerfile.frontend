# ============================================
# Этап 1: Сборка фронтенда
# ============================================
FROM docker.io/library/node:20-alpine AS builder

WORKDIR /app

# Копируем только файлы зависимостей для кэширования
COPY package.json package-lock.json* ./

# Установка зависимостей
RUN npm ci --ignore-scripts

# Копируем исходный код
COPY . .

# Сборка фронтенда
RUN npm run build

# ============================================
# Этап 2: Production образ с nginx
# ============================================
FROM docker.io/library/nginx:1.25-alpine

# Удаляем стандартную конфигурацию nginx
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Копируем конфигурацию nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Копируем собранные файлы фронтенда
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем healthcheck скрипт
COPY docker/nginx-healthcheck.sh /nginx-healthcheck.sh
RUN chmod +x /nginx-healthcheck.sh

# Открываем порт
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD /nginx-healthcheck.sh || exit 1

# Запускаем nginx в foreground режиме
CMD ["nginx", "-g", "daemon off;"]
